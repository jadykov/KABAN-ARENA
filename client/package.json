{
  "name": "@kaban-arena/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run sync-ads && tsc --noEmit && vite build",
    "sync-ads": "node scripts/sync-ads.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "colyseus.js": "0.16.22",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
